# ==============================================================================
# HOSPITAL PHARMACY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your PostgreSQL credentials.
# NEVER commit the actual .env file with real passwords.
# ==============================================================================

# Flask Configuration
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# PostgreSQL Database Configuration
# Option 1: Cloud Database URL (Neon.tech, Supabase, Render)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Local PostgreSQL / Discrete Parameters (used if DATABASE_URL is not provided)
DB_USER=postgres
DB_PASSWORD=YourSecurePassword123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmacy_db
DB_SSLMODE=prefer

# Session Security Configuration
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=60
