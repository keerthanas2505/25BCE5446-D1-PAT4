# ==============================================================================
# HOSPITAL PHARMACY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your local credentials.
# NEVER commit the actual .env file with real passwords.
# ==============================================================================

# Flask Configuration
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Oracle Database Configuration
# Pluggable Database (PDB) on Oracle XE 21c is typically XEPDB1
DB_USER=your_oracle_username
DB_PASSWORD=YourSecurePassword123
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=xepdb1

# Session Security Configuration
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=60
